# 管理后台（访问 /admin 登录）
admin_name=admin
admin_password=change-me

# 阿里云号码认证服务 - 短信认证
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# 公共签名与公共模板（短信认证服务赠送）
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_TEMPLATE_CODE=100001

# 阿里云接口地址，一般无需修改
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dypnsapi.aliyuncs.com/

# QQ 邮箱通知（有用户发帖或发评论时通知站长）
# 在 QQ 邮箱“设置 → 账户”中开启 SMTP 服务，并生成“授权码”（不是 QQ 密码）
MAIL_USERNAME=your-qq-number@qq.com
MAIL_AUTH_CODE=your-smtp-auth-code
# 接收通知的邮箱，留空则发送到 MAIL_USERNAME
MAIL_TO=your-qq-number@qq.com
# 一般无需修改
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SENDER_NAME=耶稣爱你.胜利
